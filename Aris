<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#ffe5ef">
<title>ถึงอัยหนูตะเภา ♡</title>
<style>
:root {
  --pink: #f5a9c5;
  --pink-deep: #cf5e8c;
  --pink-light: #fff3f8;
  --ink: #91405f;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  min-height: 100vh;
  padding: 28px 16px 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow-x: hidden;
  background: radial-gradient(circle at top left, #fffafd, transparent 40%),
              linear-gradient(145deg, #fff0f6, #ffdce9 55%, #fcecf5);
  color: var(--ink);
  font-family: "Trebuchet MS", "Noto Sans Thai", system-ui, sans-serif;
}
main { width: 100%; max-width: 440px; text-align: center; position: relative; z-index: 1; }
.topline { letter-spacing: 2px; font-size: 11px; text-transform: uppercase; color: #bd6d8d; }
h1 { font-size: clamp(25px, 7vw, 34px); line-height: 1.35; margin: 10px 0 8px; }
.subtitle { font-size: 14px; color: #b66785; margin-bottom: 28px; }
.envelope {
  position: relative; width: min(280px, 82vw); height: 185px; margin: 0 auto 22px;
  cursor: pointer; outline: none; filter: drop-shadow(0 12px 15px #c45e842b);
  -webkit-tap-highlight-color: transparent;
}
.env-back { position: absolute; inset: 0; background: #e88db0; border-radius: 9px; }
.paper {
  position: absolute; left: 6%; top: 5%; width: 88%; height: 90%;
  padding: 18px 8px; border-radius: 5px; background: #fffdfd;
  font-family: Georgia, serif; font-size: 14px; color: #b44c78;
  transition: top .9s ease, transform .9s ease; z-index: 2;
}
.paper small { display: block; margin-top: 15px; }
.env-flap {
  position: absolute; inset: 0; background: #f7b8d0;
  clip-path: polygon(0 0, 100% 0, 50% 63%);
  transform-origin: top; transition: transform .7s ease; z-index: 4;
}
.env-pocket {
  position: absolute; inset: 0; background: #f8c8da;
  clip-path: polygon(0 0, 50% 57%, 100% 0, 100% 100%, 0 100%); z-index: 3;
}
.seal {
  position: absolute; left: 50%; top: 48%; transform: translate(-50%,-50%);
  z-index: 5; width: 47px; height: 47px; border-radius: 50%;
  display: grid; place-items: center; background: #d75f91; color: white;
  font-size: 24px; box-shadow: 0 3px 8px #a8426c30; transition: opacity .25s;
}
.envelope.open .env-flap { transform: rotateX(180deg); z-index: 1; }
.envelope.open .paper { top: -100px; transform: translateY(-5px); z-index: 5; }
.envelope.open .seal { opacity: 0; }
.hint { font-size: 13px; margin: 0 0 23px; color: #a85b7b; }
.letter {
  display: none; text-align: left; padding: 25px 22px 22px;
  background: rgba(255,253,253,.96); border: 1px solid #f6c8d9;
  border-radius: 20px; box-shadow: 0 12px 35px #b9557a1c; line-height: 1.95;
}
.letter.show { display: block; animation: reveal .9s ease both; }
.letter h2 { text-align: center; font-size: 23px; line-height: 1.5; margin: 0 0 4px; color: #c64f82; }
.date { text-align: center; font-size: 12px; color: #c17a96; margin-bottom: 20px; }
.letter p { font-size: 15px; margin: 0 0 14px; overflow-wrap: anywhere; }
.sign { text-align: right; font-weight: 700; color: #c64f82; margin-top: 20px !important; }
button {
  border: 0; border-radius: 999px; background: #d96594; color: white;
  padding: 13px 22px; font: inherit; font-size: 14px; font-weight: 700;
  box-shadow: 0 6px 15px #cf5e8c30; cursor: pointer; margin: 8px 0 0;
}
button:active { transform: scale(.97); }
.footer { font-size: 11px; color: #b96d8b; margin-top: 25px; }
.float-heart {
  position: fixed; top: -30px; left: 0; pointer-events: none; z-index: 0;
  animation: fall linear forwards; opacity: .75;
}
@keyframes fall { to { transform: translate3d(var(--drift), 110vh, 0) rotate(360deg); opacity: .05; } }
@keyframes reveal { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
}
</style>
</head>
<body>
<main>
  <div class="topline">A little letter, just for you ♡</div>
  <h1>ถึงอัยหนูตะเภา 🐹💗</h1>
  <div class="subtitle">เปิดจดหมายจากอริสสิคะะะ</div>

  <div class="envelope" id="envelope" role="button" tabindex="0"
       aria-label="แตะเพื่อเปิดจดหมาย" aria-expanded="false">
    <div class="env-back"></div>
    <div class="paper">A tiny letter for my favorite person <span>♡</span><small>แตะเพื่ออ่านนะคะ...</small></div>
    <div class="env-flap"></div>
    <div class="env-pocket"></div>
    <div class="seal">♥</div>
  </div>
  <div class="hint" id="hint">♡ แตะซองจดหมายเพื่อเปิด ♡</div>

  <section class="letter" id="letter" aria-live="polite">
    <h2>Happy 1 Month! 💗</h2>
    <div class="date">08.10.2026 — 08.11.2026</div>
    <p>ถึงอัยหนูตะเภา 🐹</p>
    <p>แง้ง ครบรอบหนึ่งเดือนแล้วน้าคะ เรามั่ยรู้วเรยว่าจะให้อัลลัยนอกจากจับเล้กๆที่ให้คุนทั้งหมดของเรา ขอบคุนนะคะที่อยุ่ด้วยกันมาตลอดเบยย อริสรักคุนบาสมากๆนะ ขอบคุนนะคะที่เข้ามาในชีวิตเราาเราดีจัยมากเบยนะคะที่คุนเข้ามา อยุ่กับเราไปนานๆจนถึงครบรอบหนึ่งปีเลยนะคะ &lt;3 เลิฟยูวว จุ้บบบบ</p>
    <p class="sign">จาก คนที่รักคุนบาสที่สู้ดดด 💌</p>
  </section>

  <button type="button" id="heartButton">กดรับหัวใจจากเรา ♡</button>
  <div class="footer">Made with love by Aris · 08 November 2026</div>
</main>
<script>
const envelope = document.getElementById('envelope');
const letter = document.getElementById('letter');
const hint = document.getElementById('hint');
let isOpen = false;

function openLetter() {
  if (isOpen) return;
  isOpen = true;
  envelope.classList.add('open');
  envelope.setAttribute('aria-expanded', 'true');
  hint.textContent = 'จดหมายสำหรับคุณคนเดียว ♡';
  setTimeout(() => letter.classList.add('show'), 450);
  burstHearts(10);
}
envelope.addEventListener('click', openLetter);
envelope.addEventListener('keydown', (event) => {
  if (event.key === 'Enter' || event.key === ' ') {
    event.preventDefault();
    openLetter();
  }
});
function burstHearts(count = 18) {
  const symbols = ['💗', '💕', '♡', '💖', '💘'];
  for (let i = 0; i < count; i++) {
    const heart = document.createElement('span');
    heart.className = 'float-heart';
    heart.textContent = symbols[Math.floor(Math.random() * symbols.length)];
    heart.style.left = Math.random() * 100 + 'vw';
    heart.style.fontSize = (16 + Math.random() * 18) + 'px';
    heart.style.setProperty('--drift', (Math.random() * 130 - 65) + 'px');
    heart.style.animationDuration = (3 + Math.random() * 2.5) + 's';
    document.body.appendChild(heart);
    setTimeout(() => heart.remove(), 6000);
  }
}
document.getElementById('heartButton').addEventListener('click', () => burstHearts(28));

for (let i = 0; i < 12; i++) {
  const heart = document.createElement('span');
  heart.className = 'float-heart';
  heart.textContent = '♡';
  heart.style.left = Math.random() * 100 + 'vw';
  heart.style.fontSize = (13 + Math.random() * 13) + 'px';
  heart.style.setProperty('--drift', (Math.random() * 70 - 35) + 'px');
  heart.style.animationDuration = (8 + Math.random() * 9) + 's';
  heart.style.animationDelay = (-Math.random() * 15) + 's';
  document.body.appendChild(heart);
}
</script>
</body>
</html>
